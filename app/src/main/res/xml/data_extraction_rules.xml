<?xml version="1.0" encoding="utf-8"?>
<!--
   Cloud backup and device transfer (API 31+): same exclusions as backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="file" path="datastore/fcm.preferences_pb" />
        <exclude domain="file" path="datastore/config.preferences_pb" />
        <exclude domain="file" path="datastore/projects.preferences_pb" />
        <exclude domain="file" path="datastore/push_registration.preferences_pb" />
        <exclude domain="file" path="cache-v2" />
        <exclude domain="sharedpref" path="logflare_access_credentials.xml" />
        <exclude domain="sharedpref" path="logflare_access_flag.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth.preferences_pb" />
        <exclude domain="file" path="datastore/fcm.preferences_pb" />
        <exclude domain="file" path="datastore/config.preferences_pb" />
        <exclude domain="file" path="datastore/projects.preferences_pb" />
        <exclude domain="file" path="datastore/push_registration.preferences_pb" />
        <exclude domain="file" path="cache-v2" />
        <exclude domain="sharedpref" path="logflare_access_credentials.xml" />
        <exclude domain="sharedpref" path="logflare_access_flag.xml" />
    </device-transfer>
</data-extraction-rules>
