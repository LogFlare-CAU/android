<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup (API < 31). Everything is backed up except what ties the install to a session or
   push registration (tokens, server URL, FCM state) and the per-session cache; those are
   meaningless or unsafe on another install. Theme, language and recent servers stay backed up.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/auth.preferences_pb" />
    <exclude domain="file" path="datastore/fcm.preferences_pb" />
    <exclude domain="file" path="datastore/config.preferences_pb" />
    <exclude domain="file" path="datastore/projects.preferences_pb" />
    <exclude domain="file" path="datastore/push_registration.preferences_pb" />
    <exclude domain="file" path="cache-v2" />
</full-backup-content>
