<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash icon: logo on a #191F28 circle. Laid out on a 108dp canvas like an adaptive-icon
    foreground; the system shows the inner 2/3 (72dp) as a circle, which the dark disc fills.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="108dp"
        android:height="108dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="#191F28" />
        </shape>
    </item>
    <item
        android:width="31dp"
        android:height="40dp"
        android:gravity="center"
        android:drawable="@drawable/logo" />
</layer-list>
