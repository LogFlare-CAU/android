<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- AppCompat (MainActivity is an AppCompatActivity for per-app languages); Compose draws the UI. -->
    <style name="Theme.Logflareandroid" parent="Theme.AppCompat.Light.NoActionBar" />

    <!-- Launch theme: shown until the stored session is read, then swaps to Theme.Logflareandroid. -->
    <style name="Theme.Logflareandroid.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#F2F4F6</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Logflareandroid</item>
    </style>
</resources>